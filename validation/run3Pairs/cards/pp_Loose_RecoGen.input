# Pair derivation only: run3-tracking-2026-11-v1; no production payload enabled.
# Dedicated ppMC inclusive selected-event card, R04.
# Follows separate-system pPb/pp card convention; split OO cards are retained.
# Standard EEC pipeline; broad ordinary centrality interval, no separate analysis mode.
# Intended OO 0-100% coverage must pass acceptance/correction validation.
# Real event hiBin/activity is preserved; no constant or extrapolated weights.
# R08 requires native AK8 jets and applicable calibration; no AK4 substitution.
# Configuration card for energy-energy correlator analysis

# Data type for the analysis
DataType 12

# Select correlation type for Monte Carlo runs (Jet-Track)
McCorrelationType 1
MatchJets 0

# Select if you want to use the jet trigger
TriggerSelection 0   # MC: no trigger requirement

# Select which histograms to save. Checked bit by bit. Needed for memory issues.
FilledHistograms 23
                    # Bit 1 = Jet histograms                                (to set: 2)
                    # Bit 2 = Track histograms                              (to set: 4)
                    # Bit 3 = Multiplicity and particle density within jets (to set: 8)
                    # Bit 4 = Regular energy-energy correlators             (to set: 16)
                    # Bit 5 = Energy-energy correlators for systematics     (to set: 32)
                    # Bit 6 = Jet pT closure histograms                     (to set: 64)
                    # Bit 7 = Jet pT unfolding histograms                   (to set: 128)
                    # Bit 8 = Particle/track matching histograms            (to set: 256)
                    # Examples: All = 511, Everything for regular analysis = 31

# Cuts for dijets
JetType 1 # Native ak4PFJetAnalyzer/t required
JetAxis 1
JetEtaCut 1.6
MinJetPtCut 40
MaxJetPtCut 160
CutBadPhi 0                # Cut the problematic phi region. 0 = No cut, 1 = crude cut
CutWithEtaCM 0             # Cut jets that are outside of symmetric eta CM acceptance for pPb collisions within the defined jet eta cut in lab frame
MinMaxTrackPtFraction 0.01 # Minimum fraction of jet pT taken by the highest pT track in jet
MaxMaxTrackPtFraction 0.98 # Maximum fraction of jet pT taken by the highest pT track in jet
JetUncertainty 0           # 0 = Nominal jet pT, 1 = Minus uncertainty, 2 = Plus uncertainty, 3 = Nominal smear for MC, 4 = Uncertainty smear down, 5 = Uncertainty smear up

# Run-3 miniPOG Jet ID ADDED to trackMax/rawPt; whole-event veto remains separate
Run3JetID 1 # Additional to the independent trackMax/rawPt requirement
Run3JetIDTable MiniPOG20261108 # Owner-supplied HIN miniPOG table, not a dated website release
Run3JetQA 1 # Save pre-veto selection and fixed-sample calibration-stage spectra
Run3JEC 1 # Run-3 jet-pT JEC
Run3UsePpL1FastJet 0 # Current forests do not save the rho input needed by L1FastJet; keep off for production

ApplyJetVeto 1
JetVetoMapFile jetVetoMaps/pp2024/Summer24Prompt24_RunBCDEFGHI.root
JetVetoMapHistogram jetvetomap_all
JetVetoPtConvention stored # Nominal PAT/HiForest jtpt; no extra JES/JER variation
JetVetoInputMinPt 15 # Owner-declared retention bound; complete upstream coverage still requires validation

# Cuts for tracks
Run3TrackSelection Loose
TrackEtaCut 2.4
MinTrackPtCut 0.5
MaxTrackPtCut 500
MaxTrackPtRelativeError 0.1
VertexMaxDistance 5.0
SubeventCut 2

# Systematic variations applied
TrackEfficiencyVariation 0
JetPtWeight 0

# Flags for residual correction method
DisableTrackPairEfficiencyCorrection 1

# Cuts for event selection
ZVertexCut 15       # Maximum vz value for accepted tracks
LowPtHatCut -15      # Minimum accepted pT hat
HighPtHatCut 5020      # Maximum accepted pT hat
MultiplicityMode 0 # 0 = Weight MC centrality to match data. 1 = Weight multiplicity to match

# Configuration for energy-energy correlators
JetRadius 0.4
WeightExponent 1 2
SmearDeltaR 0
SmearEnergyWeight 0
JetPtBinEdgesEEC 40 80 120 160
TrackPtBinEdgesEEC 0.5 1 1.5 2 2.5 3 3.5 4 300 # Track pT bin edges for EEC

# Configuration for unfolding response matrices
SkipCovarianceMatrix 1
MinJetPtUnfoldingReco 20 # Candidate migration guard; validate before response production
MinJetPtUnfoldingTruth 10 # Candidate migration guard; validate before response production

# Binning for THnSparses
CentralityBinEdges -1 100
TrackPtBinEdges     0.7 1 2 3 4 8 12 300                # Track pT binning
PtHatBinEdges       0 30 50 80 120 170 220 280 370 460  # pT hat binning

# Choose which background estimation methods are evaluated and parameters for them
BackgroundMethods 0
                     # Bit 1 = Perpendicular cone       (to set: 2)
                     # Bit 2 = Mixed cones              (to set: 4)
                     # Examples: All = 7, Everything but no mixing = 3
MegaSkimMixing 0
EventMatchForMixing 1 # 0 = Match HiBin, 1 = Match HF energy, 2 = Match background multiplicity
BinnedMixing 0 # 0 = Match events without bin borders for mixing. 1 = Use binned event matching for mixing

# For the mixing bins, if exactly two values are given, these are interpreted as an example bin border, and bin width. The mixing bins are then automatically contructed using this information with even bin width. If more than two values are given, these are directly interpreted as bin borders.
VzMixingBins -0.5 1 # vz binning for mixing
HiBinMixingBins -0.5 1 # HiBin binning for mixing
HFEnergyMixingBins 0 1 # HF energy binning for mixing
MultiplicityMixingBins -0.5 1 # Multiplicity binning for mixing
HFEnergyShift 0

# Debug
DebugLevel 2   # 0 = No debug messages, 1 = Some debug messages, 2 = All debug messages

MaxEventsPerFile 10000
ChannelRadiusCode 4 # Persistent R04/R08 namespace
MinPairTrackPt 2
FirstUnfoldedJetPtBin 0 # Standard output starts at 40 GeV
LastUnfoldedJetPtBin 2 # Standard output ends at 160 GeV; response guards retained
