# ignore objects and archives, anywhere in the tree.
*.[oa]
*.so

# Python validation-script bytecode
__pycache__/

# Ignore data files and figures
data
*.root
!trackCorrectionTables/pp2024/Eff_ppref_2024_Pythia_QCD_pThat15_NopU_2D_Nominal_Official.root
*.pdf
*.png

# Ignore testing filelists
testFileList.txt
list*.txt

# Ignore test macros
test*.C

# Ignore the data and figure folders
figures

# Ignore .DS_Store, if mac for some reason makes this file
.DS_Store

# Ignore files generated by the makefile
eecAnalysis
eecAnalysis.dSYM
plotting/nanoDict.cc
plotting/nanoDict_rdict.pcm

# Ignore analysis tar ball
eec5TeV.tar.gz

# Retain map-content evidence images; candidate ROOT payloads remain untracked.
!validation/run3Jets/evidence/2026-10-28/*.png
!validation/run3Jets/evidence/2026-10-28/native-replay/*.png

# Owner-enabled Run-3 R4 veto maps referenced by local and CRAB cards.
!jetVetoMaps/OO2025/Summer24Prompt25_RunCDEFG.root
!jetVetoMaps/ppRef2024/Summer24Prompt24_RunBCDEFGHI.root

# Bounded local MC closure artifacts (source/cards/helpers are versioned separately).
validation/run3Mixing/results/

# Plotting header dependencies and ROOT/compiler environment signature.
plotting/*.d
plotting/.root-build-config*
plotting/.sys.v#..root-build-config/

# Reproducible local pair-correction samples, native files and closure artifacts.
validation/run3Pairs/results/

# Local production state and reproducible worker payloads.
/crab.log
/crab/crab.log
/crab/eec*.tar.gz
/crab/eecAnalysis_*/
/crab/submissionRecords/
/crab/OOForestfiles/previous_10parts/
/crab/ppRefForestfiles/previous_10parts/
/crab/ppRefForestfiles/worker_build.log

# Campaign outputs stay local; reusable cards and test fixtures are versioned.
/validation/run3Campaign/results/
/validation/run3Unfolding/results/
